# Absolute path to the Android project root that devilge is allowed to inspect.
# REQUIRED. Any file access outside this directory will be rejected.
DEVILGE_ANDROID_PROJECT_ROOT=/absolute/path/to/your/android/project

# Optional. Absolute path to the `adb` binary. If not set, devilge will rely on
# `adb` being available on PATH. Pinning the path is recommended for security.
DEVILGE_ADB_PATH=/usr/local/bin/adb

# Optional. Default device serial when multiple devices are attached.
# DEVILGE_DEFAULT_DEVICE_SERIAL=emulator-5554

# Optional. Maximum number of logcat lines a single tool call can return.
# Defaults to 500. Hard upper-bound is 5000 to prevent unbounded output.
DEVILGE_LOGCAT_MAX_LINES=500

# Optional. Log level: error | warn | info | debug. Defaults to info.
DEVILGE_LOG_LEVEL=info

# Optional. Default logcat tag the HTTP-client logger writes under.
# Defaults to "HttpClient" (Ktor's Logger.ANDROID default).
# - Ktor projects: typically "HttpClient" or whatever tag your custom logger uses.
# - Retrofit/OkHttp projects: typically "OkHttp".
# Can be overridden per call via the tool's `tag` argument.
# DEVILGE_KTOR_LOG_TAG=HttpClient

# Optional. Which HTTP-log format(s) to parse. Values:
#   ktor   — only Ktor Logging plugin output
#   okhttp — only OkHttp HttpLoggingInterceptor output (Retrofit uses this)
#   auto   — try both parsers (default; cheap, recommended)
# DEVILGE_HTTP_LOG_FORMAT=auto

# Optional. Where devilge writes artifacts (screenshots, UI dumps, Compose
# preview renders). Created at startup if missing.
# Default: <DEVILGE_ANDROID_PROJECT_ROOT>/.devilge-outputs/
# IMPORTANT: add this directory to your project's .gitignore.
# DEVILGE_OUTPUTS_ROOT=/absolute/path/to/devilge-outputs

# Optional. Where Maestro YAML flows live. Created at startup if missing.
# Default: <DEVILGE_ANDROID_PROJECT_ROOT>/devilge-flows/
# DEVILGE_FLOWS_ROOT=/absolute/path/to/devilge-flows

# Optional. Path to the maestro CLI binary. If unset, devilge searches PATH.
# Phase 13.B is OPTIONAL — devilge runs fully without Maestro; the run/list/
# validate tools return MAESTRO_NOT_INSTALLED when the binary is missing.
# Install with: brew install maestro    (https://maestro.mobile.dev)
# DEVILGE_MAESTRO_BIN_PATH=/usr/local/bin/maestro

# Optional, OFF by default. When `true`, allow `runScript:` blocks inside
# Maestro flow YAMLs. They execute JS — only enable if every flow under
# DEVILGE_FLOWS_ROOT is reviewed and trusted.
# DEVILGE_ALLOW_FLOW_SCRIPTS=true
