{
  "name": "devilge",
  "version": "0.1.0",
  "description": "MCP server that exposes Android project insights (logcat, Jetpack Compose previews, project structure) to AI assistants like Claude.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "devilge": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "android",
    "adb",
    "jetpack-compose",
    "kmm",
    "claude",
    "developer-tools"
  ],
  "author": "Yercko",
  "license": "MIT",
  "homepage": "https://github.com/yercko/devilge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yercko/devilge.git"
  },
  "bugs": {
    "url": "https://github.com/yercko/devilge/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
